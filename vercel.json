{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/journal/:slug", "destination": "/post?slug=:slug" },
    { "source": "/casebook/:slug", "destination": "/post?slug=:slug" },
    { "source": "/rights/:slug", "destination": "/post?slug=:slug" },
    { "source": "/perspective/:slug", "destination": "/post?slug=:slug" },
    { "source": "/research/:slug", "destination": "/post?slug=:slug" },
    { "source": "/the-brief/:slug", "destination": "/post?slug=:slug" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
